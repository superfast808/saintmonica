<%- include('partials/head') %>
<%- include('partials/header') %>
<main id="main-content">
  <section class="page-hero scenic-hero contact-hero">
    <div class="page-hero-copy">
      <p class="eyebrow">Contact St Monica’s</p>
      <h1>How can we help?</h1>
      <p><%= settings.contact_intro %></p>
    </div>
    <div class="page-hero-art"><% if(meta.image){ %><img src="<%= meta.image %>" alt="" aria-hidden="true"><% } %></div>
  </section>

  <section class="section contact-layout">
    <div class="contact-details">
      <p class="eyebrow">Parish office</p>
      <h2>Get in touch.</h2>
      <div class="contact-detail"><span>Address</span><strong><%= settings.address %></strong></div>
      <div class="contact-detail"><span>Telephone</span><a href="tel:<%= settings.phone.replace(/\s/g,'') %>"><%= settings.phone %></a></div>
      <div class="contact-detail"><span>Email</span><a href="mailto:<%= settings.email %>"><%= settings.email %></a></div>
      <div class="contact-detail"><span>Parish priest</span><strong><%= settings.parish_priest %></strong></div>
      <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=St+Monica%27s+Church+Sharp+Avenue+Coatbridge+ML5+5RP" target="_blank" rel="noopener">Open directions ↗</a>
    </div>

    <div class="contact-form-card">
      <% if(sent){ %>
        <div class="success-message"><span>✓</span><h2>Thank you.</h2><p>Your message has been received by the parish website.</p></div>
      <% } else { %>
        <p class="eyebrow">Send a message</p>
        <h2>Parish enquiry</h2>
        <% if(error){ %><div class="form-error" role="alert"><%= error %></div><% } %>
        <form method="post" action="/contact" class="contact-form">
          <label><span>Your name</span><input name="name" autocomplete="name" required value="<%= form.name || '' %>"></label>
          <label><span>Email address</span><input type="email" name="email" autocomplete="email" required value="<%= form.email || '' %>"></label>
          <label><span>Phone <small>optional</small></span><input name="phone" autocomplete="tel" value="<%= form.phone || '' %>"></label>
          <label><span>How can we help?</span><textarea name="message" rows="7" required><%= form.message || '' %></textarea></label>
          <button class="button button-gold" type="submit">Send enquiry</button>
          <p class="form-note">Your details are used only to respond to your parish enquiry. See our <a href="/privacy">privacy notice</a>.</p>
        </form>
      <% } %>
    </div>
  </section>

  <section class="section hall-contact-mini">
    <div><p class="eyebrow">Parish Hall</p><h2>Hall booking?</h2><p>Hall enquiries are handled separately from the parish office.</p></div>
    <div><a href="tel:<%= settings.hall_phone.replace(/\s/g,'') %>"><%= settings.hall_phone %></a><a href="mailto:<%= settings.hall_email %>"><%= settings.hall_email %></a></div>
  </section>
</main>
<%- include('partials/footer') %>
