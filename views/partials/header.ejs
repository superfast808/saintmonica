<div class="utility-bar">
  <div class="utility-inner">
    <div class="utility-left">
      <span>Roman Catholic Parish · Diocese of Motherwell</span>
      <a href="<%= settings.diocese_url %>" target="_blank" rel="noopener">Diocese website ↗</a>
    </div>
    <div class="utility-contact">
      <a href="mailto:<%= settings.email %>"><span aria-hidden="true">✉</span><span><%= settings.email %></span></a>
      <a href="tel:<%= settings.phone.replace(/\s/g,'') %>"><span aria-hidden="true">☎</span><span><%= settings.phone %></span></a>
    </div>
  </div>
</div>

<header class="site-header" data-header>
  <a class="brand" href="/" aria-label="St Monica's Parish home">
    <span class="brand-mark" aria-hidden="true"><i></i><b>SM</b></span>
    <span class="brand-copy"><strong>St Monica’s</strong><small>Catholic Church · Coatbridge</small></span>
  </a>

  <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="site-nav">
    <span>Menu</span><i></i><i></i>
  </button>

  <nav class="site-nav" id="site-nav" data-nav aria-label="Primary navigation">
    <a class="<%= path === '/' ? 'active' : '' %>" href="/">Home</a>

    <div class="nav-group <%= path === '/mass-times' || path === '/sacraments' ? 'active' : '' %>" data-nav-group>
      <button class="nav-trigger" type="button" data-nav-trigger aria-expanded="false">Mass & Sacraments <span class="nav-chevron" aria-hidden="true"><svg viewBox="0 0 12 12"><path d="M3 4.5 6 7.5 9 4.5"/></svg></span></button>
      <div class="nav-dropdown">
        <a href="/mass-times"><strong>Mass & prayer times</strong><small>Sunday, weekday, Adoration and Reconciliation</small></a>
        <a href="/sacraments"><strong>The Sacraments</strong><small>Baptism, Communion, Confirmation, Marriage and more</small></a>
      </div>
    </div>

    <div class="nav-group <%= path === '/parish' || path === '/parish-hall' || path === '/gallery' ? 'active' : '' %>" data-nav-group>
      <button class="nav-trigger" type="button" data-nav-trigger aria-expanded="false">Our Parish <span class="nav-chevron" aria-hidden="true"><svg viewBox="0 0 12 12"><path d="M3 4.5 6 7.5 9 4.5"/></svg></span></button>
      <div class="nav-dropdown">
        <a href="/parish"><strong>Parish & clergy</strong><small>Our mission and parish priest</small></a>
        <a href="/parish-hall"><strong>Parish Hall</strong><small>Functions, facilities and bookings</small></a>
        <a href="/gallery"><strong>Gallery</strong><small>Images from parish life</small></a>
      </div>
    </div>

    <a class="<%= path === '/bulletins' ? 'active' : '' %>" href="/bulletins">Bulletins</a>
    <a class="<%= path.startsWith('/news') ? 'active' : '' %>" href="/news">News</a>
    <a class="nav-cta <%= path === '/contact' ? 'active' : '' %>" href="/contact">Contact</a>
  </nav>
</header>
